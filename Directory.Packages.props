<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Anthropic" Version="12.35.1" />
    <PackageVersion Include="Google.GenAI" Version="1.13.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Explicit lift: Microsoft.Data.Sqlite 10.0.9 pulls SQLitePCLRaw 2.1.11
         (NU1903 high, GHSA-2m69-gcr7-jv3q); upstream 2.1.12 stable landed 2026-07-09.
         Direct reference in IronHive.Core so the >= 2.1.12 floor propagates to package consumers.
         Remove once Microsoft.Data.Sqlite's transitive floor reaches 2.1.12. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.8.0" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.8.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.11.2" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
  </ItemGroup>
  <ItemGroup Label="Azure">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="Azure.Storage.Files.Shares" Version="12.27.1" />
  </ItemGroup>
  <ItemGroup Label="AWS">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup Label="Serialization">
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup Label="JSON Schema">
    <PackageVersion Include="JsonSchema.Net" Version="9.2.2" />
    <PackageVersion Include="JsonSchema.Net.Generation" Version="7.3.10" />
  </ItemGroup>
  <ItemGroup Label="Document Processing">
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>
  <ItemGroup Label="Tokenizers">
    <PackageVersion Include="Tiktoken" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Qdrant.Client" Version="1.18.1" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>
  <ItemGroup Label="Utilities">
    <PackageVersion Include="dotenv.net" Version="4.0.2" />
    <PackageVersion Include="Scriban" Version="7.2.5" />
    <PackageVersion Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>
</Project>