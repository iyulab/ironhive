<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Anthropic" Version="13.1.0" />
    <PackageVersion Include="Google.GenAI" Version="1.24.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Api" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xUnit v3/MTP native mode: no Microsoft.NET.Test.Sdk needed, coverlet.collector was a dead
         reference (CI never invoked the coverage collector flag) -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Label="Serialization">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup Label="Tokenizers">
    <PackageVersion Include="Tiktoken.Core" Version="3.1.5" />
    <PackageVersion Include="Tiktoken.Encodings.cl100k" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup Label="Utilities">
    <PackageVersion Include="dotenv.net" Version="4.0.2" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Test-only: hosts a real MCP server in-process so the adapter can be driven over a real
         handshake instead of a transport seam. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
  </ItemGroup>
</Project>